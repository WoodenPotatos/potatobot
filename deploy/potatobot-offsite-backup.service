# Daily offsite copy of the live database, via rclone to a remote configured
# by hand (`rclone config`) — this unit only invokes rclone, it does not set
# a remote up.
#
# Install:
#   sudo cp deploy/potatobot-offsite-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now potatobot-offsite-backup.timer
#
# This runs `scripts/offsite_backup.py`, which copies exactly one file -- a
# `pg_dump` of the database, checked with `pg_restore --list` -- never the
# project tree. A prior attempt (`backup.sh`, deleted 2026-05-20) copied the
# whole tree and would have swept `.env` into the destination; this unit is
# deliberately given no access to `.env` at all, since the backup needs no
# Discord or OAuth secret. The database password comes from the service
# user's `~/.pgpass` (0600), which libpq reads by itself; the host, database
# and role are the `PG*` settings below. Needs a `pg_dump`/`pg_restore` at
# least as new as the server.
#
# `ProtectHome=read-only` rather than `true`: rclone reads its remote
# configuration from the service user's `~/.config/rclone/rclone.conf` by
# default, so home has to stay readable. It still cannot be written to.
#
# `User=woody`, not a dedicated `potatobot` system account: none exists on
# the deployed host -- `potatobot.service` itself runs as `woody` (confirmed
# via `systemctl show potatobot.service -p User`), matching the other unit
# in this directory (see `potatobot-everydle-drift.service`'s own note).
#
# `ReadWritePaths=/opt/potatobot`: the prune deletes the pre-migration dumps
# in `backups/`, and nothing else. The dump itself goes to a private temporary directory.
#
# `ReadWritePaths=/home/woody/.config/rclone`: rclone periodically tries to
# rewrite its own config file (observed 2026-09-27, most likely persisting a
# refreshed OAuth token) using a write-temp-file-then-rename pattern, which
# needs write access to the *directory*, not just the file -- a path scoped
# to `rclone.conf` itself would not be enough for the temp file's own
# creation. Under plain `ProtectHome=read-only` this failed every night with
# "read-only file system"; the backup itself kept succeeding regardless,
# since it only ever reads the config, but a token that genuinely needs
# refreshing (rather than routine housekeeping) would eventually have failed
# silently until backups stopped working with no earlier warning. Scoped to
# this one directory rather than loosening `ProtectHome` itself, for the same
# reason the database access above is scoped to one directory rather than
# all of `/opt`.
#
# `gdrivecrypt:` is an `rclone crypt` remote layered over the Drive remote
# (`gdrivebot:PotatoBotBackups-crypt`), so the database is encrypted before it
# leaves the host. Before 2026-10-16 this pointed at `gdrivebot:PotatoBotBackups`
# directly, which meant that anyone holding the Google account or its refresh
# token could read every balance, warning and ticket. The crypt passwords
# have to live in `rclone.conf` for the upload to work. Keep a copy *off* the
# host, because losing the host is exactly when the backup is needed, and
# without the passwords the copies cannot be read.
#
# Read the result with:
#   journalctl -u potatobot-offsite-backup --since '1 week ago'

[Unit]
Description=PotatoBot offsite database backup
Documentation=https://github.com/WoodenPotatos/potatobot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=woody
Group=woody
WorkingDirectory=/opt/potatobot
Environment=PGHOST=localhost
Environment=PGDATABASE=potatobot
Environment=PGUSER=potatobot
# `--prune-local-backups-days 90`: the retention docs/legal/PRIVACY.md §7
# promises for the pre-migration copies, the bot's dumps.
ExecStart=/opt/potatobot/venv/bin/python /opt/potatobot/scripts/offsite_backup.py gdrivecrypt: --backups-dir /opt/potatobot/backups --prune-local-backups-days 90
SyslogIdentifier=potatobot-offsite-backup

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/potatobot
ReadWritePaths=/home/woody/.config/rclone
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
