# PotatoBot dashboard, supervised separately from the bot.
#
# Install:
#   sudo cp deploy/potatobot-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now potatobot-dashboard
#
# Running the dashboard as its own service means restarting it never interrupts
# Discord, and a dashboard fault cannot take the bot down. The two coordinate
# only through SQLite: feature changes converge by revision polling within about
# two seconds, and queued Discord publishes travel through the control_actions
# outbox, which only the bot process executes.
#
# Set POTATOBOT_DASHBOARD_ENABLED=false in the shared environment file so the
# bot does not also start an in-process dashboard thread.
#
# Note the dashboard needs DISCORD_TOKEN as well as the OAuth values: without an
# in-process bot it reads guild channels and roles over the Discord REST API.

[Unit]
Description=PotatoBot dashboard
Documentation=https://github.com/WoodenPotatos/potatobotbeta
After=network-online.target potatobot.service
Wants=network-online.target
# The bot owns schema creation; start after it so a fresh database is migrated.
After=potatobot.service
# [Unit] keys since systemd v230; ignored if placed in [Service].
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=potatobot
Group=potatobot
WorkingDirectory=/opt/potatobot
EnvironmentFile=/opt/potatobot/.env
Environment=POTATOBOT_DASHBOARD_ENABLED=true
ExecStart=/opt/potatobot/venv/bin/python /opt/potatobot/dashboard_api.py

Restart=on-failure
RestartSec=10s
TimeoutStopSec=15

SyslogIdentifier=potatobot-dashboard

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/potatobot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Every file the service creates -- the database's WAL sidecars, a migration's
# backup, a log -- lands group-readable and world-nothing. Without this the
# service inherited 0022 and a backup of every member's balance sat 0644 beside
# the database. A migration run *by hand* still uses the login shell's umask;
# docs/installation.md wraps that command in `(umask 027; ...)`.
UMask=0027
# The process needs no capability at all: it binds no privileged port, changes
# no ownership, and runs as its own account.
CapabilityBoundingSet=
# The service-wide syscall set: enough for Python, SQLite, ffmpeg and sockets,
# not enough to load a kernel module or reboot. A call outside it answers EPERM
# rather than killing the process, so a surprise is a logged error, not an
# outage -- check the journal for `EPERM` after the first start with this.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# No device nodes but the pseudo ones; ffmpeg decodes from a URL, not a card.
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
ProtectClock=true
ProtectHostname=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
