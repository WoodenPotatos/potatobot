# PotatoBot (devboard) as a rootless podman container, through Quadlet.
#
# Measured locally 2026-10-16: the image built and run under exactly the
# flags Quadlet generates from this file migrates, logs and refuses a
# placeholder token the way the bare-metal bot does, with files landing 0640.
#
# Install, as the `potatobot` system account (lingering enabled, so it starts
# at boot without a login):
#   install -m 0644 deploy/potatobot.container ~potatobot/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start potatobot
#
# Quadlet generates `potatobot.service` from this file; `systemctl --user
# enable` does not apply to a generated unit, the [Install] section does.
#
# One container, bot and dashboard in one process, matching the host today
# (one service; `potatobot-dashboard` was never installed). The bot owns
# schema creation and migrates at start, after a `pg_dump` whenever a
# migration is pending (2.21). Its PostgreSQL is `potatobot-db.container`, on
# the private `potatobot.network`; install all three together.

[Unit]
Description=PotatoBot Discord bot (rootless podman)
After=network-online.target potatobot-db.service
Wants=network-online.target
# The database unit is ready only once PostgreSQL answers over TCP
# (`Notify=healthy`), so the bot starts after it; stopping the database stops
# the bot rather than leaving it reconnecting to nothing.
Requires=potatobot-db.service
# The same backoff as deploy/potatobot.service. GATEWAY_GRACE_SECONDS in
# main.py is sized against these two numbers (RestartLimitTests), so they
# must not drift apart between the two ways of running the bot.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
ContainerName=potatobot
# A stable local tag rather than the version, so a release never has to edit
# an installed unit. A deploy builds `potatobot:<version>-<commit>` and moves
# this tag onto it; a rollback moves the tag back to the previous image. The
# commit is in the name because the alpha line deploys one version many times.
Image=localhost/potatobot:devboard

# The host account maps onto the image's own `potatobot` (uid 10001), so the
# bind-mounted data directory is owned by the same account on both sides.
UserNS=keep-id:uid=10001,gid=10001

# Data on a bind mount, not a named volume, so the host-side offsite-backup
# and drift units keep reading a plain path. `Z`: the host enforces SELinux.
# `bot/` on the encrypted mount; PostgreSQL's data is the `pgdata/` beside it.
# With the volume closed `bot/` does not exist and podman refuses to start,
# which is the guard (`deploy/potatobot-unlock`). `RequiresMountsFor=` is not
# one: a rootless user manager sees only mounts that exist, so `/` meets it
# (measured 2026-11-01), and the earlier draft that relied on it is gone.
Volume=/var/lib/potatobot/bot:/data:Z
Network=potatobot.network

# Secrets stay out of the image and out of this file: root:potatobot 0640.
# PGPASSWORD, the bot role's, is in it; the database superuser's is not.
EnvironmentFile=/etc/potatobot/potatobot.env
Environment=PGHOST=potatobot-db
Environment=PGDATABASE=potatobot
Environment=PGUSER=potatobot
Environment=POTATOBOT_DATA_DIR=/data
# Where 2.20's SQLite file sits, which the copy script reads at the cutover.
Environment=POTATOBOT_DB_PATH=/data/economy.db
Environment=POTATOBOT_LOG_DIR=/data/logs
Environment=POTATOBOT_EVERYDLE_STATE_PATH=/data/everydle_state.json
Environment=POTATOBOT_DASHBOARD_ENABLED=true
# Inside the container's own network namespace; the host side is loopback.
Environment=POTATOBOT_DASHBOARD_HOST=0.0.0.0
Environment=POTATOBOT_DASHBOARD_PORT=5000
# cloudflared on the host is the one proxy hop in front of the dashboard.
Environment=POTATOBOT_TRUSTED_PROXY_HOPS=1

# Loopback only. cloudflared reaches it on 127.0.0.1:5000, exactly as today;
# a published port bypasses firewalld, so this mapping is the only restriction.
PublishPort=127.0.0.1:5000:5000

# The container-native hardening subset compose.yaml already ships.
NoNewPrivileges=true
DropCapability=all
# The root filesystem is read-only: the code cannot be rewritten by the process
# running it, and every write already goes to /data. Trialled on the image
# 2026-10-30: migration, dashboard, logging, an image card and a YouTube lookup
# all ran; podman's default `--read-only-tmpfs` gives /tmp, /var/tmp and /run.
# Voice playback was not trialled (it needs the live token): if a song fails
# after a deploy, this line is the first thing to remove.
ReadOnly=true
# What `UMask=0027` is to deploy/potatobot.service: without it the container
# inherits 0022 and every pre-migration dump and the session secret land 0644
# on the host's bind mount. Measured 2026-10-16. Quadlet has
# no key of its own for this, so it goes through to `podman run` directly.
PodmanArgs=--umask=0027

# The host's timezone, as the bare-metal bot had. `core/clock.py` keeps
# calendar days local ("played today" is the operator's midnight) and reads a
# stored timestamp with no offset as local time; in a container's default UTC
# the day turned at 02:00 CEST and those legacy values read two hours off
# (seen on the cutover, 2026-10-22). `local` bind-mounts the host's
# /etc/localtime, so the image needs no tzdata of its own.
Timezone=local

# A small init (catatonit) as PID 1, forwarding signals to the bot. Python as
# PID 1 ignores SIGTERM, which Linux only delivers to PID 1 through a handler
# it installed, so every stop waited out podman's 10 seconds and ended in
# SIGKILL (seen on the cutover's first restart, 2026-10-22; measured 10.1 s
# without, 0.17 s with). With it a stop is the SIGTERM the bare-metal unit sent.
RunInit=true

[Service]
Restart=on-failure
RestartSec=10s
# The bot ends on the stop's SIGTERM, which podman reports as 143 (128 + 15);
# without this every clean stop left the unit `failed`. A crash, the watchdog's
# exit(1) and a SIGKILL still count as failures and still restart.
SuccessExitStatus=143
TimeoutStopSec=30
SyslogIdentifier=potatobot

[Install]
WantedBy=default.target
