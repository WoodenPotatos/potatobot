# PotatoBot Discord bot.
#
# Install:
#   sudo cp deploy/potatobot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now potatobot
#
# This unit owns schema creation, so start it before the dashboard on a fresh
# database. Set POTATOBOT_DASHBOARD_ENABLED=false in the environment file when
# running the dashboard as its own service.

[Unit]
Description=PotatoBot Discord bot
Documentation=https://github.com/WoodenPotatos/potatobotbeta
After=network-online.target
Wants=network-online.target
# Discord outages and DNS problems can flap; back off rather than hammer.
# These are [Unit] keys: systemd moved them out of [Service] in v230 and
# silently ignores them there, which reverts the backoff to 5-in-10s.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=potatobot
Group=potatobot
WorkingDirectory=/opt/potatobot
EnvironmentFile=/opt/potatobot/.env
ExecStart=/opt/potatobot/venv/bin/python /opt/potatobot/main.py

Restart=on-failure
RestartSec=10s
TimeoutStopSec=30

# The August 2026 incident was host DNS, so keep the journal identifiable.
SyslogIdentifier=potatobot

# Hardening. The service needs the working directory writable for the database
# and its WAL sidecars, and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/potatobot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Left off until measured on the host: PyNaCl and yt-dlp may map W+X pages
# for their native code, and a first start with `true` is the only way to
# know. Try it on the deployment; if voice or extraction survives, keep it.
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Every file the service creates -- the database's WAL sidecars, a migration's
# backup, a log -- lands group-readable and world-nothing. Without this the
# service inherited 0022 and a backup of every member's balance sat 0644 beside
# the database. A migration run *by hand* still uses the login shell's umask;
# docs/installation.md wraps that command in `(umask 027; ...)`.
UMask=0027
# The process needs no capability at all: it binds no privileged port, changes
# no ownership, and runs as its own account.
CapabilityBoundingSet=
# The service-wide syscall set: enough for Python, SQLite, ffmpeg and sockets,
# not enough to load a kernel module or reboot. A call outside it answers EPERM
# rather than killing the process, so a surprise is a logged error, not an
# outage -- check the journal for `EPERM` after the first start with this.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# No device nodes but the pseudo ones; ffmpeg decodes from a URL, not a card.
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
ProtectClock=true
ProtectHostname=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
