# Discord bot
DISCORD_TOKEN=replace_with_discord_bot_token

# Deployment profile: private, managed, or self_hosted
POTATOBOT_DEPLOYMENT_PROFILE=private

# PostgreSQL (2.21), through libpq's own variables. The role is the bot's own,
# not a superuser (deploy/postgres-init/10-potatobot-role.sh creates it).
# Compose and the Quadlet units set PGHOST, PGDATABASE and PGUSER themselves;
# PGPASSWORD is the one this file must hold. The database superuser's password
# belongs in ../.env.postgres, which only the database container reads.
PGHOST=localhost
PGDATABASE=potatobot
PGUSER=potatobot
PGPASSWORD=replace_with_the_bot_roles_password
POTATOBOT_DB_READ_WORKERS=4
# Only for upgrading a 2.x database to 3.0 (schema 27): the guild its existing
# wallets were earned in, when the bot serves more than one guild and no 2.x
# adoption marker names it. Ignored unless it is a positive integer.
POTATOBOT_LEGACY_GUILD_ID=replace_with_original_guild_id
# Optional overrides for the mutable state that defaults to living beside the
# source tree. A container points all three at its data volume, so a rebuild
# does not reset them.
# POTATOBOT_LOG_DIR=/data/logs
# POTATOBOT_EVERYDLE_STATE_PATH=/data/everydle_state.json
# Where the dashboard session secret, welcome-card backgrounds and the
# pre-migration dumps (backups/) live. Unset or blank means beside the code.
# POTATOBOT_DATA_DIR=/data
# Log lines also go to stdout (the journal under systemd) unless this is false;
# they name members, so turn it off where the journal is less protected than
# the log directory.
# POTATOBOT_LOG_CONSOLE=true

# Twitch application used by cogs/socials.py
TWITCH_CLIENT_ID=replace_with_twitch_client_id
TWITCH_CLIENT_SECRET=replace_with_twitch_client_secret

# Test dashboard OAuth configuration
DISCORD_CLIENT_ID=replace_with_discord_oauth_client_id
DISCORD_CLIENT_SECRET=replace_with_discord_oauth_client_secret
DISCORD_REDIRECT_URI=https://potatobot.your-tailnet.ts.net/api/callback
ADMIN_DISCORD_ID=replace_with_admin_user_id
POTATOBOT_DASHBOARD_ENABLED=true
POTATOBOT_DASHBOARD_HOST=127.0.0.1
POTATOBOT_DASHBOARD_PORT=5000
POTATOBOT_DASHBOARD_EXTERNAL_URL=https://potatobot.your-tailnet.ts.net
# Reverse-proxy hops whose forwarded headers are trusted. Defaults to 1 when an
# external URL is set, which matches a single front end: Tailscale Serve, nginx
# alone, or a Cloudflare Tunnel straight to loopback. Cloudflare in front of
# nginx is 2, and the origin must then accept Cloudflare's addresses only.
# Set it explicitly only if your topology differs; 0 disables header trust.
POTATOBOT_TRUSTED_PROXY_HOPS=1
# Prefer an environment secret; otherwise a private local secret file is generated.
POTATOBOT_DASHBOARD_SESSION_SECRET=replace_with_a_long_random_value

# Optional: email alert on a recurring ERROR/CRITICAL log line (core/logging_setup.py).
# Blank POTATOBOT_ALERT_EMAIL_TO or _SMTP_HOST disables alerting entirely.
# POTATOBOT_ALERT_EMAIL_TO=you@example.com
# POTATOBOT_ALERT_SMTP_HOST=smtp.example.com
# POTATOBOT_ALERT_SMTP_PORT=587
# POTATOBOT_ALERT_SMTP_USER=replace_with_smtp_username
# POTATOBOT_ALERT_SMTP_PASSWORD=replace_with_smtp_password
# POTATOBOT_ALERT_SMTP_FROM=replace_with_sender_address
