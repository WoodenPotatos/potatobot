# PotatoBot container image.
#
# One image serves both roles. The bot is the default; the dashboard is the same
# image started with a different command, which is what lets the two run as
# separate supervised services against one PostgreSQL database (2.21), which
# runs in its own container (deploy/potatobot-db.container, compose's `db`).
#
# Build (from the repository root):  podman build -t potatobot:2.21.34a -f container/Containerfile .
# Bot:    podman run --env-file .env -v potatobot-data:/data potatobot:2.21.34a
# Panel:  podman run --env-file .env -v potatobot-data:/data -p 127.0.0.1:5000:5000 \
#             potatobot:2.21.34a python dashboard_api.py

# Pinned by digest, not tag: `3.13-slim` is a moving name, and an image that
# changes under the same tag is a supply-chain change nobody reviewed.
# Resolved 2026-09-17 with `skopeo inspect`; the image itself is dated
# 2026-09-01. Bump the digest deliberately, with the date.
FROM python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285 AS base

# ffmpeg is required for music playback. The PostgreSQL 18 client is what the
# bot's pre-migration backup runs (`pg_dump` must be at least the server's
# version, and Debian trixie ships 17), so it comes from PostgreSQL's own apt
# repository, set up by Debian's `postgresql-common`, whose bundled signing key
# is the trust anchor -- no key is fetched over the network here. sqlite3 stays
# for the move from 2.20: the copy script and the cutover read the old file
# (todo.md, "2.20.0: PostgreSQL"); it goes once the SQLite file is archived.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ffmpeg ca-certificates sqlite3 \
        postgresql-common \
    && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
    && apt-get install --yes --no-install-recommends postgresql-client-18 \
    && rm -rf /var/lib/apt/lists/*

# Never run as root, and give the account a real home so caches land somewhere
# writable rather than in the image.
RUN useradd --create-home --uid 10001 potatobot

WORKDIR /app

# Dependencies first, so a source change does not invalidate the install layer.
COPY requirements.lock ./
RUN python -m pip install --no-cache-dir --require-hashes --requirement requirements.lock

# Root-owned and read-only to the runtime user: code the process can rewrite
# is code a compromise can persist in. Everything the bot writes at runtime
# is pointed at the volume below instead -- the logs, the Everydle deck, the
# pre-migration dumps, and the dashboard's session secret and welcome-card
# backgrounds in the data directory. The database itself is PostgreSQL's.
COPY . .

# Mutable state lives on a volume, never in the image, so an upgrade cannot
# replace it and a rollback cannot lose it; these paths would otherwise
# default into `/app`, which this image does not let the runtime user write.
# POTATOBOT_DB_PATH names where 2.20's SQLite file sits, for the copy script.
ENV POTATOBOT_DB_PATH=/data/economy.db \
    POTATOBOT_DATA_DIR=/data \
    POTATOBOT_LOG_DIR=/data/logs \
    POTATOBOT_EVERYDLE_STATE_PATH=/data/everydle_state.json \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN mkdir -p /data && chown potatobot:potatobot /data
VOLUME ["/data"]

USER potatobot

# Fails the container if PostgreSQL cannot be reached with the bot's own
# credentials (libpq's PG* environment), which is the failure that matters
# most on startup. The start period covers `wait_for_database`'s minute.
HEALTHCHECK --interval=60s --timeout=10s --start-period=75s --retries=3 \
    CMD python -c "import psycopg; psycopg.connect('', connect_timeout=5).execute('SELECT 1')"

# Files the process creates are owner and group only. The Quadlet unit passes
# `--umask=0027`, but compose has no portable key for it, so a compose-run bot
# would inherit 0022 and write a world-readable database; setting it here
# covers every way the image is started. `exec` makes the command PID 1
# itself, so it still receives the stop signal directly.
ENTRYPOINT ["/bin/sh", "-c", "umask 0027 && exec \"$@\"", "--"]
CMD ["python", "main.py"]
